# Standard Chatwoot environment file — see
# https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables
# The real .env on the server carries the full set; these are the required keys.
SECRET_KEY_BASE=changeme
FRONTEND_URL=https://chat.baileys.app
ENABLE_ACCOUNT_SIGNUP=false
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5434
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme
RAILS_ENV=development
RAILS_MAX_THREADS=5
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ENABLE_PUSH_RELAY_SERVER=true
