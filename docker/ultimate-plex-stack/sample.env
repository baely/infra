# User/Group IDs (find with: id $(whoami))
PUID=1000
GUID=1000
TZ=Australia/Sydney

# Paths
BASE_PATH=/home/user/github/ultimate-plex-stack
MEDIA_SHARE=/mnt/docker

# VPN (PIA) credentials for qbit-vpn
VPN_USER=changeme
VPN_PASS=changeme

# Plex claim token (https://plex.tv/claim) — only needed on first setup
PLEX_CLAIM=claim-xxxx-xxxx
