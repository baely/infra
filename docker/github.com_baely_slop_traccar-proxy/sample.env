# Secret path segment. The Traccar client's server URL becomes
# https://tp.xbd.au/<TOKEN>. Generate with: openssl rand -hex 12
TOKEN=changeme

# One TARGET_<NAME> per upstream. Query params fixed on a target URL override
# the client's (handy for a per-service device id). Userinfo becomes Basic auth.
TARGET_TRACCAR=https://traccar.example.com:5055
TARGET_HA=https://ha.example.com/api/webhook/changeme?id=phone
